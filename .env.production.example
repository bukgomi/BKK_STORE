# ─────────────────────────────────────────────────────────────
# 운영 환경변수 예시 (VPS + docker-compose.prod.yml)
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# .env.production 은 .gitignore 에 있다 — 절대 커밋하지 않는다.
# 이 파일에는 실제 값을 넣지 않는다. 비어 있는 값은 <PLACEHOLDER> 로 남겨 두었다.
# ─────────────────────────────────────────────────────────────

# ── 도메인 / 인증서 (Caddy) ──
PUBLIC_DOMAIN="<PLACEHOLDER: 예 topcasting.co.kr — 가비아 DNS 가 VPS IP 를 가리켜야 함>"
ACME_EMAIL="<PLACEHOLDER: Let's Encrypt 만료 알림을 받을 이메일>"

# ── PostgreSQL (compose 내부 전용, 외부 포트 공개 안 함) ──
POSTGRES_USER="bkk"
POSTGRES_PASSWORD="<PLACEHOLDER: openssl rand -hex 24>"
POSTGRES_DB="bkk_store"

# ── Redis (compose 내부 전용) ──
REDIS_PASSWORD="<PLACEHOLDER: openssl rand -hex 24>"

# ── 앱 기본 ──
# DATABASE_URL / REDIS_URL 은 compose 가 위 값으로 조합한다 (여기 적지 않는다)
NEXTAUTH_URL="https://<PLACEHOLDER: PUBLIC_DOMAIN 과 동일>"
NEXTAUTH_SECRET="<PLACEHOLDER: openssl rand -base64 32>"
# ⚠️ ENCRYPTION_KEY 는 로컬(.env.docker)에서 쓰던 값을 그대로 가져와야 한다.
#    값이 다르면 이미 암호화된 회원 전화번호·주소 등을 복호화하지 못한다. (64자 hex)
#    개발 DB 를 옮기지 않고 완전히 새로 시작한다면 openssl rand -hex 32 로 새로 만들어도 된다.
ENCRYPTION_KEY="<PLACEHOLDER: 로컬 .env.docker 의 ENCRYPTION_KEY 값>"
CRON_SECRET="<PLACEHOLDER: openssl rand -base64 32>"
NOTIFY_CRON_TOKEN="<PLACEHOLDER: openssl rand -base64 32>"
NEXT_PUBLIC_SITE_URL="https://<PLACEHOLDER: PUBLIC_DOMAIN 과 동일>"
# CSRF 허용 출처 (콤마 구분). 보통 사이트 주소 하나면 된다
ALLOWED_ORIGINS="https://<PLACEHOLDER: PUBLIC_DOMAIN 과 동일>"

# ── 최초 관리자 시드 (docs/DEPLOY.md 참고 — 시드 후 ADMIN_PASSWORD 는 지우거나 바꾼다) ──
ADMIN_EMAILS="<PLACEHOLDER: 관리자 이메일>"
ADMIN_NAME="관리자"
ADMIN_PASSWORD="<PLACEHOLDER: 최초 관리자 비밀번호 — 시드 후 제거>"
ADMIN_RESET_PASSWORD="false"

# ── 이미지 저장소: Cloudflare R2 (S3 호환) ──
STORAGE_PROVIDER="s3"
S3_BUCKET="<PLACEHOLDER: R2 버킷 이름>"
S3_REGION="auto"
S3_ENDPOINT="https://<PLACEHOLDER: R2 계정 ID>.r2.cloudflarestorage.com"
S3_ACCESS_KEY="<PLACEHOLDER: R2 API 토큰 Access Key ID>"
S3_SECRET_KEY="<PLACEHOLDER: R2 API 토큰 Secret Access Key>"
# 업로드 파일이 공개되는 주소. R2 의 "공개 액세스" 를 켜면 https://pub-xxxx.r2.dev, 커스텀 도메인이면 https://img.도메인
S3_PUBLIC_URL="https://<PLACEHOLDER: pub-xxxx.r2.dev 또는 img.도메인>"
S3_FORCE_PATH_STYLE="false"
# next/image 가 불러올 수 있는 외부 이미지 호스트 (콤마 구분, 프로토콜 없이 호스트명만)
# 예: IMAGE_REMOTE_HOSTS="pub-xxxx.r2.dev"   또는   IMAGE_REMOTE_HOSTS="img.topcasting.co.kr"
IMAGE_REMOTE_HOSTS="<PLACEHOLDER: S3_PUBLIC_URL 의 호스트명>"

# ── DB 백업 업로드 (docs/BACKUP.md — rclone 리모트 이름:버킷/경로) ──
BACKUP_RCLONE_REMOTE="r2:<PLACEHOLDER: 백업 버킷명>/db-backups"

# ── 결제 (PG) — 운영 키로 교체 ──
TOSS_CLIENT_KEY="<PLACEHOLDER>"
TOSS_SECRET_KEY="<PLACEHOLDER>"
NEXT_PUBLIC_TOSS_CLIENT_KEY="<PLACEHOLDER: TOSS_CLIENT_KEY 와 동일>"
TOSS_WEBHOOK_SECRET="<PLACEHOLDER: 토스 콘솔 웹훅 시크릿>"
INICIS_MID="<PLACEHOLDER>"
INICIS_SIGN_KEY="<PLACEHOLDER>"
INICIS_API_KEY="<PLACEHOLDER: 환불 API 키 (선택)>"
INICIS_API_PWD="<PLACEHOLDER: 환불 API 비밀번호 (선택)>"
INICIS_NOTIFY_ALLOWED_IPS=""
NEXT_PUBLIC_INICIS_ENV="production"
NAVERPAY_CLIENT_ID="<PLACEHOLDER>"
NAVERPAY_CLIENT_SECRET="<PLACEHOLDER>"
NAVERPAY_CHAIN_ID="<PLACEHOLDER>"

# ── 소셜 로그인 (선택 — 비우면 해당 버튼이 동작하지 않음) ──
# 콜백: https://도메인/api/auth/callback/naver , https://도메인/api/auth/callback/kakao
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# ── 본인인증 / 알림 (선택) ──
IDENTITY_PROVIDER="mock"

# ── 에러 트래킹 (선택 — 비우면 Sentry 비활성) ──
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENV="production"

# ── 운영 파라미터 ──
LOG_LEVEL="info"
POINT_EARN_RATE="0.01"
LOW_STOCK_THRESHOLD="10"

# ── 사업자 정보 (푸터/법적 고지) ──
NEXT_PUBLIC_BUSINESS_NAME="탑캐스팅"
NEXT_PUBLIC_BUSINESS_CEO="<PLACEHOLDER>"
NEXT_PUBLIC_BUSINESS_NO="<PLACEHOLDER: 사업자등록번호>"
NEXT_PUBLIC_ECOMM_REG_NO="<PLACEHOLDER: 통신판매업 신고번호>"
NEXT_PUBLIC_BUSINESS_ADDRESS="<PLACEHOLDER>"
NEXT_PUBLIC_CS_PHONE="<PLACEHOLDER>"
NEXT_PUBLIC_CS_EMAIL="<PLACEHOLDER>"
NEXT_PUBLIC_CS_HOURS="평일 09:00 ~ 18:00"
NEXT_PUBLIC_PRIVACY_OFFICER="<PLACEHOLDER>"
NEXT_PUBLIC_PRIVACY_EMAIL="<PLACEHOLDER>"
