{
  "name": "fishing-mall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:seed:cms": "tsx prisma/seed-cms.ts",
    "db:seed:fresh": "tsx prisma/seed-fresh.ts",
    "db:seed:categories": "tsx prisma/seed-categories.ts",
    "docker:up": "docker compose up -d && docker compose logs -f app",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app worker",
    "docker:reset": "docker compose down -v",
    "docker:db:dump": "docker compose exec db pg_dump -U fishing -d fishing_mall --no-owner --no-privileges -Fc -f /tmp/fishing_mall.dump && docker compose cp db:/tmp/fishing_mall.dump ./fishing_mall.dump",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx scripts/worker.ts",
    "worker:watch": "tsx --watch scripts/worker.ts",
    "migrate:technote:parse": "tsx scripts/migrate/technote/parse.ts",
    "migrate:technote:review": "tsx scripts/migrate/technote/export-review.ts",
    "migrate:technote:import": "tsx scripts/migrate/technote/import.ts",
    "migrate:smartstore:convert": "tsx scripts/migrate/smartstore/convert.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.51.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.5",
    "ioredis": "^5.10.1",
    "next": "14.2.15",
    "next-auth": "^4.24.10",
    "nodemailer": "^7.0.0",
    "otplib": "^13.4.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.16",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5",
    "vitest": "^2.1.5"
  }
}
